# Konfigurasi lokal untuk mencoba login melalui API pusat.
# Pastikan browser mengakses frontend lokal lewat HTTPS jika cookie secure=true.
ICLABS_API_BASE_URL=https://iclabs.fikom.umi.ac.id/api/v1
ICLABS_API_CONNECT_TIMEOUT_SECONDS=3
ICLABS_API_TIMEOUT_SECONDS=10
# Synchronous AI matching can take longer than other API calls.
ICLABS_API_AI_TIMEOUT_SECONDS=150
ICLABS_API_TLS_VERIFY=true
ICLABS_PRAKTIKUM_API_MODE=true
ICLABS_PRAKTIKUM_SESSION_PATH=
ICLABS_PRAKTIKUM_SECURE_COOKIE=false
