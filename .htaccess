Options -Indexes

# Blokir total akses publik ke .env, config.php, .git, dan semua file sensitif
<FilesMatch "(^\.|\.env|config\.php|composer\.(json|lock)|\.sql|\.md)$">
    Require all denied
</FilesMatch>

# Aturan Apache Rewrite untuk memblokir dotfiles
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^aktivasi-akun/?$ aktivasi.php [L,QSA]
    RewriteRule ^reset-password/?$ reset-password.php [L,QSA]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>
